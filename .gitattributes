# Los ficheros que se ejecutan o leen en el servidor Linux deben llevar
# saltos de línea LF aunque se editen en Windows: con CRLF, bash falla
# ("$'\r': command not found") y sshd/systemd pueden leer mal la config.
*.sh        text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.py        text eol=lf
config/userdb.txt text eol=lf

# Binarios: nunca convertir
*.png  binary
*.docx binary
*.pdf  binary
