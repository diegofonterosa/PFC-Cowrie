# =====================================================================
#  /etc/systemd/system/cowrie.service - Honeypot Cowrie (PFC-Cowrie)
#  Arranca Cowrie en primer plano bajo systemd, como usuario sin
#  privilegios y con el sistema de ficheros en solo lectura salvo var/.
# =====================================================================
[Unit]
Description=Cowrie SSH honeypot (PFC-Cowrie)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cowrie
Group=cowrie
WorkingDirectory=/home/cowrie/honeypot
# Se lanza twistd directamente y en primer plano (-n), con la salida al
# journal (journalctl -u cowrie). Es lo que hace "cowrie start" con
# COWRIE_STDOUT=yes, salvo dos detalles que lo rompian bajo systemd:
#  - "cowrie start" busca twistd en el PATH y systemd no activa el venv
#    (FileNotFoundError): aqui va la ruta completa.
#  - twistd escribe twistd.pid en el directorio de trabajo, que el
#    confinamiento deja en solo lectura: --pidfile= lo desactiva (systemd
#    ya sabe el PID del proceso).
ExecStart=/home/cowrie/honeypot/cowrie-env/bin/twistd --umask=0022 -n --pidfile= --logger cowrie.python.logfile.stdoutLogger cowrie
Restart=always
RestartSec=10

# Confinamiento: aunque alguien escapase de Cowrie, no podria escribir
# fuera de var/ ni ganar privilegios.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/cowrie/honeypot/var
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
